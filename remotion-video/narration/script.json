{
  "minGapSeconds": 0.2,
  "lines": [
    { "id": 1, "start": 0, "end": 2, "voice": "narrator", "text": "해파리 만개" },
    { "id": 2, "start": 4, "end": 7, "voice": "narrator", "text": "AI 덕분에 우리의 삶은 더 편리해지고" },
    { "id": 3, "start": 9, "end": 12, "voice": "narrator", "text": "짧은 시간에 더 많은 일을 할 수 있게 됐습니다." },
    { "id": 4, "start": 14, "end": 17, "voice": "narrator", "text": "기술이 우리의 예측과 통제를 넘어설 만큼 발전한다면" },
    { "id": 5, "start": 18, "end": 22, "voice": "narrator", "text": "우리는 무엇에 가치를 두고 살아가야 할까요?" },
    { "id": 6, "start": 23, "end": 28, "voice": "narrator", "text": "해파리 만개는 여섯 편의 단편을 엮은 소설집입니다." },
    { "id": 7, "start": 29, "end": 32, "voice": "narrator", "text": "서로 다른 세계를 그리는 이야기들은" },
    { "id": 8, "start": 33, "end": 38, "voice": "narrator", "text": "우리가 존재의 가치를 판단하는 방식을 돌아보게 합니다." },
    { "id": 9, "start": 39, "end": 44, "voice": "narrator", "text": "그 중 해파리 만개에 관한 기록을 따라가 보겠습니다." },
    { "id": 10, "start": 45, "end": 50, "voice": "narrator", "text": "앤트로픽은 투자설명서에서 안전장치와 감독, 보안이 불충분한 고도 AI가" },
    { "id": 11, "start": 51, "end": 55, "voice": "narrator", "text": "인류에 심각한 위험을 가져올 가능성을 언급합니다." },
    { "id": 12, "start": 56, "end": 58, "voice": "narrator", "text": "이 소설은 다른 질문을 던집니다." },
    { "id": 14, "start": 60, "end": 64, "voice": "narrator", "emphasis": true, "text": "편리함을 위한 시스템이 삶의 기준까지 정한다면?" },
    { "id": 15, "start": 66, "end": 69, "voice": "narrator", "text": "작품 속 도시는 AI 시스템 '시놉시스'의 관리와 감시 아래 있습니다." },
    { "id": 16, "start": 71, "end": 74, "voice": "narrator", "text": "여기에 연결된 시노봇은 거리를 청소하고 질서를 유지하지만" },
    { "id": 17, "start": 76, "end": 78, "voice": "narrator", "text": "사람들의 일상도 지켜봅니다." },
    { "id": 18, "start": 80, "end": 83, "voice": "narrator", "text": "칩을 이식한 사람이 취업에서 유리한 사회" },
    { "id": 19, "start": 85, "end": 90, "voice": "narrator", "text": "원치 않더라도, 기회를 놓치지 않기 위해 이식을 고민하게 됩니다." },
    { "id": 20, "start": 92, "end": 95, "voice": "narrator", "text": "편리함을 위한 기술은 어느새 선택의 기준이 됩니다." },
    { "id": 21, "start": 100, "end": 104, "voice": "narrator", "text": "어느 날, 도시 곳곳에 해파리 형태의 비생물적 존재들이 나타납니다." },
    { "id": 22, "start": 105, "end": 109, "voice": "narrator", "text": "얇은 필름 같은 몸으로 허공을 떠돌며 점차 늘어납니다." },
    { "id": 23, "start": 110, "end": 114, "voice": "narrator", "text": "효율과 기능으로 모든 것을 분류하던 도시에는, 설명하기 어려운 출현입니다." },
    { "id": 24, "start": 116, "end": 119, "voice": "narrator", "emphasis": true, "text": "도시 곳곳에 나타난 해파리 형태의 비생물적 존재" },
    { "id": 25, "start": 120, "end": 124, "voice": "narrator", "text": "처음에는 낯설어 거리를 두던 사람들도, 조금씩 이 풍경을 바라봅니다." },
    { "id": 26, "start": 126, "end": 129, "voice": "narrator", "text": "무엇을 하는지 묻기 전에 그저 떠 있는 존재에 시선이 머뭅니다." },
    { "id": 27, "start": 130, "end": 134, "voice": "narrator", "text": "해파리가 달라진 걸까요, 아니면 바라보는 기준이 달라진 걸까요?" },
    { "id": 28, "start": 136, "end": 138, "voice": "narrator", "emphasis": true, "text": "경계하던 시선이, 머무르는 시선으로" },
    { "id": 29, "start": 139, "end": 143, "voice": "narrator", "text": "바다에도 해파리가 대규모로 모이거나 늘어나는 '해파리 만개'가 있습니다." },
    { "id": 30, "start": 145, "end": 149, "voice": "narrator", "text": "수온, 먹이, 주변 환경 등 여러 조건이 작용하고, 종과 해역에 따라 양상도 다릅니다." },
    { "id": 31, "start": 150, "end": 152, "voice": "narrator", "text": "실제 해파리는 먹이망의 일부입니다." },
    { "id": 32, "start": 153, "end": 157, "voice": "narrator", "text": "작품은 이 이름을 빌려 우리가 가치를 판단하는 기준을 묻습니다." },

    { "id": 33, "start": 165, "end": 166, "voice": "A", "text": "해파리들이 내 생각에 장난을 쳤거든." },
    { "id": 34, "start": 167, "end": 169, "voice": "B", "text": "무슨 생각?" },
    { "id": 35, "start": 170, "end": 172, "voice": "A", "text": "능력만이 가치있다는 생각." },
    { "id": 36, "start": 175, "end": 177, "voice": "B", "style": "monologue", "text": "나는 흘러가는 해파리들을 보았다." },
    { "id": 37, "start": 179, "end": 182, "voice": "B", "style": "monologue", "text": "물 속에 잠긴 것처럼 숨이 막히는데, 이상하게 무언가에서 해방된 기분이 든다." },
    { "id": 38, "start": 185, "end": 187, "voice": "B", "style": "monologue", "text": "억죄된 것들, 도시의 원칙들." },
    { "id": 39, "start": 188, "end": 190, "voice": "B", "style": "monologue", "text": "그게 정확히 무엇인지 알 수 없다." },
    { "id": 40, "start": 194, "end": 200, "voice": "B", "style": "monologue", "text": "하지만 능력만이 가치 있는 게 아니라면, 무엇도 할 수 없는 것은 어떤 가치가 있는데?" },
    { "id": 41, "start": 203, "end": 207, "voice": "B", "text": "이 해파리들은 아무런 기능이 없어. 능력도 없고, 아무것도 할 수 없잖아." },
    { "id": 42, "start": 209, "end": 214, "voice": "B", "text": "그냥 위아래로 움직이고, 부유하고," },
    { "id": 44, "start": 215, "end": 218, "voice": "B", "text": "존재하는 게 다인걸." },
    { "id": 45, "start": 222, "end": 226, "voice": "B", "text": "무쓸모한 것들이 도시를 가득 채우면, 뭘 할 수 있는데?" },
    { "id": 46, "start": 227, "end": 231, "voice": "B", "text": "그저 무쓸모한 게 늘어날 뿐인데..." },
    { "id": 47, "start": 235, "end": 238, "voice": "A", "text": "그러면 세상을 멈춰 세울 수 있어." },

    { "id": 48, "start": 243, "end": 246, "voice": "narrator", "text": "이 대화는 우리에게도 이어집니다." },
    { "id": 49, "start": 247, "end": 251, "voice": "narrator", "text": "우리는 하루를 얼마나 많이 해냈는지로만 평가하고 있지는 않을까요?" },
    { "id": 50, "start": 253, "end": 257, "voice": "narrator", "text": "아무것도 완성하지 못한 시간, 당장 성과로 설명할 수 없는 취향과 관계." },
    { "id": 51, "start": 258, "end": 262, "voice": "narrator", "text": "그 안에도 우리가 놓치고 있던 가치가 있을지 모릅니다." },
    { "id": 52, "start": 263, "end": 265, "voice": "narrator", "text": "우리는 스스로를 무엇으로 평가하고 있을까?" },
    { "id": 53, "start": 267, "end": 269, "voice": "narrator", "text": "기술이 더 많은 일을 해내는 시대." },
    { "id": 54, "start": 271, "end": 274, "voice": "narrator", "text": "잠시 멈춰, 우리가 소중하게 여기는 것을 바라봅니다." },
    { "id": 55, "start": 277, "end": 281, "voice": "narrator", "text": "우리는 무엇을 가치 있게 여기며 살아갈 것인가?" }
  ]
}
